# ── Visa Atlas v1.0 环境变量（复制为 .env 后按需修改） ──────────────────
# 默认使用项目内 SQLite（零依赖）。MySQL 模式见 .env.mysql.example。

HOST=127.0.0.1
PORT=3001

# sqlite | mysql
DB_DRIVER=sqlite
DATA_DB_PATH=data/visaatlas.sqlite

# MySQL 模式使用（DB_DRIVER=mysql）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visa_atlas
DB_USER=visa_app
DB_PASSWORD=
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# 可选：Vite 开发服务器端口（改端口时同步 vite.config.ts 代理）
WEB_PORT=5173
