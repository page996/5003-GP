# 本机 MySQL 开发配置示例：复制为 .env 使用
# 需要先创建数据库与账号：
#   CREATE DATABASE visa_atlas CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'visa_app'@'127.0.0.1' IDENTIFIED BY 'REPLACE_ME';
#   GRANT ALL PRIVILEGES ON visa_atlas.* TO 'visa_app'@'127.0.0.1';

HOST=127.0.0.1
PORT=3001
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visa_atlas
DB_USER=visa_app
DB_PASSWORD=REPLACE_ME
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
